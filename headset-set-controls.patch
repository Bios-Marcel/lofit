index 0000000..91bdba1
--- /dev/null
+++ b/app/src/main/java/lofit/HeadsetSetControls.kt
@@ -0,0 +1,110 @@
+package lofit
+
+import android.content.Context
+import android.content.Intent
+import android.media.AudioManager
+import android.media.MediaPlayer
+import android.media.session.MediaSession
+import android.media.session.PlaybackState
+import android.os.Handler
+import android.os.Looper
+import android.view.KeyEvent
+
+/** Keeps headset routing after a single silent clip, until another app plays audio. */
+internal class HeadsetSetControls(
+    private val context: Context,
+    private val completeSet: () -> Unit,
+) : AutoCloseable {
+    private val audio = context.getSystemService(AudioManager::class.java)
+    private var session: MediaSession? = null
+    private var player: MediaPlayer? = null
+
+    fun onActivityEntered() {
+        if (audio.isMusicActive || player != null) return
+        val clip = MediaPlayer.create(context, R.raw.headset_silence) ?: return
+        // Preparation can take time; leave music alone if it started meanwhile.
+        if (audio.isMusicActive) {
+            clip.release()
+            return
+        }
+        val controls =
+            session
+                ?: MediaSession(context, "Lofit headset sets").also {
+                    it.setCallback(
+                        object : MediaSession.Callback() {
+                            override fun onSkipToNext() {
+                                completeSet()
+                            }
+
+                            // Some headsets send PLAY while our silent session is paused.
+                            override fun onPlay() {
+                                completeSet()
+                            }
+
+                            override fun onMediaButtonEvent(intent: Intent): Boolean {
+                                val key =
+                                    intent.getParcelableExtra(
+                                        Intent.EXTRA_KEY_EVENT,
+                                        KeyEvent::class.java,
+                                    )
+                                when (key?.keyCode) {
+                                    KeyEvent.KEYCODE_MEDIA_NEXT,
+                                    KeyEvent.KEYCODE_MEDIA_PLAY,
+                                    KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE -> {
+                                        if (
+                                            key.action == KeyEvent.ACTION_DOWN &&
+                                                key.repeatCount == 0
+                                        )
+                                            completeSet()
+                                        return true
+                                    }
+                                    else -> return super.onMediaButtonEvent(intent)
+                                }
+                            }
+                        },
+                        Handler(Looper.getMainLooper()),
+                    )
+                    session = it
+                }
+        player = clip
+        clip.setOnCompletionListener {
+            player = null
+            it.release()
+            setState(controls, PlaybackState.STATE_PAUSED)
+        }
+        clip.setOnErrorListener { _, _, _ ->
+            close()
+            true
+        }
+        controls.isActive = true
+        setState(controls, PlaybackState.STATE_PLAYING)
+        // Actual zero-valued samples, not a muted player. No audio focus or looping needed.
+        try {
+            clip.start()
+        } catch (_: IllegalStateException) {
+            close()
+        }
+    }
+
+    private fun setState(controls: MediaSession, state: Int) {
+        controls.setPlaybackState(
+            PlaybackState.Builder()
+                .setActions(
+                    PlaybackState.ACTION_SKIP_TO_NEXT or
+                        PlaybackState.ACTION_PLAY or
+                        PlaybackState.ACTION_PLAY_PAUSE
+                )
+                .setState(state, 0L, if (state == PlaybackState.STATE_PLAYING) 1f else 0f)
+                .build()
+        )
+    }
+
+    override fun close() {
+        player?.setOnCompletionListener(null)
+        player?.setOnErrorListener(null)
+        player?.release()
+        player = null
+        session?.release()
+        session = null
+    }
+}
